# --- App ---
PORT=3000
NODE_ENV=development

# --- Postgres ---
DATABASE_URL=postgres://megapharm:megapharm@localhost:5432/megapharm

# --- Auth (JWT do painel admin) ---
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=12h

# --- Primeiro admin (usado por `npm run seed`) ---
ADMIN_EMAIL=admin@megafarma.com.br
ADMIN_PASSWORD=troque-esta-senha

# --- Webhook do checkout-simples (HMAC) ---
# Segredo do endpoint cadastrado no painel /webhooks do checkout-simples.
# O checkout assina o corpo com HMAC-SHA256 e envia no header x-webhook-signature.
# Vazio = verificacao desligada (so em dev).
WEBHOOK_SECRET=troque-este-segredo-do-webhook

# Eventos que disparam baixa (csv, minusculo). Vazio = aceita qualquer evento.
ACCEPTED_EVENTS=transaction.paid

# --- HubSpot (line items do pedido) ---
# O checkout nao envia SKU/qtd; buscamos os line items do deal (external_ref) no HubSpot.
# Private App token com escopos: crm.objects.deals.read + crm.objects.line_items.read
HUBSPOT_API_TOKEN=
# Propriedade do line item que guarda o SKU (padrao HubSpot: hs_sku)
HUBSPOT_SKU_PROPERTY=hs_sku
# Base da API (troque so em testes/mock)
HUBSPOT_BASE_URL=https://api.hubapi.com
